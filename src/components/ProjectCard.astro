---
import type { FeaturedProject } from '../../data/site';
import { Icon } from 'astro-icon/components'; // Tambahkan import Icon

interface Props {
  project: FeaturedProject & { demoLink?: string }; // Menambahkan referensi tipe opsional
  imageSrc?: string;
}

const { project, imageSrc: imageOverride } = Astro.props;

const techCategories = project.techCategories;
const imageSrc = imageOverride ?? (project.image ? (project.image.startsWith('/') ? project.image : `/${project.image}`) : undefined);
---

<article class="scroll-stat panel-card group space-y-6">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h3 class="text-2xl font-semibold text-slate">
        {project.title}
      </h3>
      {project.period && <p class="mt-1 font-mono text-sm text-accent">{project.period}</p>}
    </div>
    
    {/* Tombol Demo Link Render Kondisional */}
    {project.demoLink && (
      <a
        href={project.demoLink}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex shrink-0 items-center gap-2 rounded-full border border-slate-700/50 bg-slate-800/30 px-3 py-1.5 text-sm font-medium text-accent transition-colors hover:bg-slate-700/50 hover:text-slate-light"
      >
        Live Demo
        <Icon name="ph:arrow-up-right" class="h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
      </a>
    )}
  </header>

  {imageSrc && (
    <div class="w-full max-w-3xl overflow-hidden rounded-xl">
      <img
        src={imageSrc}
        alt={project.imageAlt ?? ''}
        class="h-56 w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="space-y-4">
    <p class="body-copy">{project.summary}</p>

    {project.solution && (
      <div>
        <dt class="text-xs uppercase tracking-wider text-accent">Solution</dt>
        <dd class="mt-1.5 text-slate">{project.solution}</dd>
      </div>
    )}
    {project.impact && (
      <div>
        <dt class="text-xs uppercase tracking-wider text-accent">Impact</dt>
        <dd class="mt-1.5 text-slate">{project.impact}</dd>
      </div>
    )}
  </div>

  <div>
    <dt class="mb-3 text-xs uppercase tracking-wider text-accent">Technologies / Tools</dt>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {techCategories.map((techCat) => (
        <div>
          <h4 class="mb-2 text-xs uppercase tracking-wider text-slate-lightest">
            {techCat.category}
          </h4>
          <ul class="space-y-1">
            {techCat.items.map((item) => (
              <li class="text-sm text-slate-light">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</article>

<style>
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = Array.from(cards).indexOf(entry.target);
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 3) * 150); 
          
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -10px 0px'
    });

    cards.forEach(card => observer.observe(card));
  }

  revealCards();
  
  document.addEventListener('astro:after-swap', revealCards);
</script>