---
import { site } from '@data/site';
import ContactBar from './ContactBar.astro';

interface Props {
  variant: 'sidebar' | 'mobile';
}

const { variant } = Astro.props;
const isSidebar = variant === 'sidebar';

// Membuat ID unik untuk masing-masing varian (mobile & sidebar)
const modalId = `cv-modal-${variant}`;
const captchaModalId = `captcha-modal-${variant}`;
---

{isSidebar ? (
  <>
    <div class="relative group mb-8 reveal-content flex justify-center" style="animation-delay: 100ms;">
      <div class="balloon-float w-20 h-20 md:w-24 md:h-24 rounded-full border-2 border-accent overflow-hidden shadow-[0_0_60px_theme(colors.slate.700/10%)] group-hover:shadow-[0_0_80px_theme(colors.slate.700/15%)] transition-shadow">
        <img src={site.hero.avatarSrc} alt={site.hero.avatarAlt} class="h-full w-full scale-110 object-cover" loading="eager" decoding="async" width="96" height="96" />
      </div>
      <div class="balloon-float absolute -z-10 top-1 left-1 h-full w-full rounded-full bg-slate-900/10 backdrop-blur-xl"></div>
    </div>

    <div class="flex flex-col items-center text-center">
      <a href={import.meta.env.BASE_URL} class="text-5xl font-bold tracking-tight text-white transition">
        {site.hero.name}
      </a>
      <p class="mt-3 text-xl font-medium text-slate-light">{site.hero.role}</p>
      <p class="body-copy mt-5 max-w-xs">{site.hero.tagline}</p>
      <p class="body-copy mt-5 max-w-xs">{site.hero.contact}</p>

      <div class="mt-6 flex justify-center">
        <button 
          data-modal-target={modalId} 
          data-captcha-target={captchaModalId}
          class="cv-btn group flex items-center justify-center gap-2 cursor-pointer bg-transparent py-2 px-5 rounded-full border border-slate-500/30 text-sm font-medium text-yellow-400 transition-all hover:text-yellow-400 hover:border-slate-400/60 hover:bg-white/5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:scale-110">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          RESUME
        </button>
      </div>

      <div class="mt-5 flex justify-center gap-4">
        <ContactBar />
      </div>
    </div>
  </>
) : (
  <div class="flex flex-col items-center text-center">
    <div class="relative mb-4">
      <div class="h-20 w-20 rounded-full border-2 border-accent overflow-hidden shadow-[0_0_50px_theme(colors.slate.700/10%)]">
        <img src={site.hero.avatarSrc} alt={site.hero.avatarAlt} class="h-full w-full object-cover" loading="eager" decoding="async" width="80" height="80" />
      </div>
      <div class="absolute -z-10 top-0 left-0 h-full w-full rounded-full bg-slate-900/10 backdrop-blur-lg"></div>
    </div>
    <h1 class="text-4xl font-bold tracking-tight text-white transition">
      {site.hero.name}
    </h1>
    <p class="mt-3 text-xl font-semibold tracking-tight text-slate-light">{site.hero.role}</p>
    <div class="mt-4 max-w-prose space-y-3 text-lg leading-relaxed text-slate">
      <p>{site.hero.tagline}</p>
      <p>{site.hero.contact}</p>
      
      <div class="mt-6 flex justify-center">
        <button 
          data-modal-target={modalId} 
          data-captcha-target={captchaModalId}
          class="cv-btn group flex items-center justify-center gap-2 cursor-pointer bg-transparent py-2 px-5 rounded-full border border-slate-500/30 text-sm font-medium text-yellow-400 transition-all hover:text-yellow-400 hover:border-slate-400/60 hover:bg-white/5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:scale-110">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          RESUME
        </button>
      </div>

    </div>
    <div class="mt-2 mb-6 flex items-center justify-center gap-4">
      <ContactBar />
    </div>
  </div>
)}

<dialog 
  id={captchaModalId} 
  class="captcha-dialog m-auto rounded-xl border border-neutral-800 bg-neutral-950 p-6 shadow-2xl text-white outline-none focus:outline-none backdrop:bg-neutral-900/80 backdrop:backdrop-blur-sm no-scrollbar"
>
  <h3 class="mb-4 text-lg font-semibold">Security Check</h3>
  <p class="mb-2 text-sm text-neutral-400">Masukkan 6 angka berikut untuk melihat CV:</p>
  
  <div class="captcha-display mb-4 text-3xl font-mono tracking-[0.25em] bg-neutral-900 p-4 text-center rounded select-none font-bold"></div>
  
  <input 
    type="text" 
    maxlength="6" 
    class="captcha-input w-full mb-4 p-2 rounded bg-neutral-800 border border-neutral-700 text-white text-center font-mono tracking-[0.25em] text-xl focus:outline-none focus:border-neutral-500 transition-colors" 
    placeholder="000000" 
  />
  
  <div class="flex gap-3 justify-end">
    <button class="cancel-captcha px-4 py-2 rounded bg-neutral-800 hover:bg-neutral-700 transition text-sm cursor-pointer">Batal</button>
    <button class="verify-captcha px-4 py-2 rounded bg-white text-black font-semibold hover:bg-neutral-200 transition text-sm cursor-pointer">Verifikasi</button>
  </div>
</dialog>

<dialog 
  id={modalId} 
  class="cv-dialog relative m-auto w-[85vw] max-w-4xl h-[88vh] rounded-xl border border-neutral-800 bg-neutral-950 p-0 shadow-2xl overflow-hidden outline-none focus:outline-none focus-visible:outline-none no-scrollbar"
>
  <a 
    href={site.hero.resumeUrl} 
    download
    class="absolute bottom-6 right-6 z-20 flex h-12 w-12 items-center justify-center rounded-full bg-neutral-800/90 border border-neutral-600 text-white shadow-xl backdrop-blur-md transition-all hover:bg-neutral-700 hover:scale-105 cursor-pointer"
    title="Download CV"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
      <polyline points="7 10 12 15 17 10"/>
      <line x1="12" x2="12" y1="15" y2="3"/>
    </svg>
  </a>

  <div class="w-full h-full overflow-hidden bg-neutral-950 flex flex-col justify-center items-center relative no-scrollbar">
    <iframe 
      data-pdf-url={site.hero.resumeUrl}
      data-prod-url={`${site.url}${site.hero.resumeUrl}`}
      class="cv-iframe h-full border-none outline-none block z-10 no-scrollbar"
      style="width: calc(100% + 24px); margin-right: -24px;"
      title="CV PDF Viewer"
    ></iframe>
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-4">
      <p class="text-sm text-neutral-500 mb-3">Memuat dokumen PDF...</p>
      <a href={site.hero.resumeUrl} target="_blank" class="text-xs text-neutral-400 underline hover:text-white z-20">Buka langsung di tab baru jika gagal memuat</a>
    </div>
  </div>
</dialog>

<script>
  function setupCVModals() {
    const cvBtns = document.querySelectorAll('.cv-btn');
    
    cvBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cvTargetId = btn.getAttribute('data-modal-target');
        const captchaTargetId = btn.getAttribute('data-captcha-target');
        
        if (!cvTargetId || !captchaTargetId) return;

        const targetCvModal = document.getElementById(cvTargetId) as HTMLDialogElement;
        const captchaModal = document.getElementById(captchaTargetId) as HTMLDialogElement;

        if (!targetCvModal || !captchaModal) return;

        const display = captchaModal.querySelector('.captcha-display') as HTMLDivElement;
        const input = captchaModal.querySelector('.captcha-input') as HTMLInputElement;
        const verifyBtn = captchaModal.querySelector('.verify-captcha') as HTMLButtonElement;
        const cancelBtn = captchaModal.querySelector('.cancel-captcha') as HTMLButtonElement;

        if (!display || !input || !verifyBtn || !cancelBtn) return;

        let currentCode = Math.floor(100000 + Math.random() * 900000).toString();
        display.textContent = currentCode;
        input.value = '';
        
        captchaModal.showModal();
        setTimeout(() => input.focus(), 100);

        const handleVerify = () => {
          if (input.value === currentCode) {
            captchaModal.close();
            
            const iframe = targetCvModal.querySelector('.cv-iframe') as HTMLIFrameElement;
            if (iframe && !iframe.src) {
              const pdfUrl = iframe.getAttribute('data-pdf-url') || '';
              const prodUrl = iframe.getAttribute('data-prod-url') || '';
              
              if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
                iframe.src = `${pdfUrl}#toolbar=0&navpanes=0&scrollbar=0`;
              } else {
                iframe.src = `https://docs.google.com/gview?url=${encodeURIComponent(prodUrl)}&embedded=true`;
              }
            }
            
            targetCvModal.showModal();
          } else {
            alert('Kode Captcha tidak sesuai. Silakan coba lagi.');
            currentCode = Math.floor(100000 + Math.random() * 900000).toString();
            display.textContent = currentCode;
            input.value = '';
            input.focus();
          }
        };

        verifyBtn.onclick = handleVerify;
        input.onkeypress = (e) => { if (e.key === 'Enter') handleVerify(); };
        cancelBtn.onclick = () => captchaModal.close();
      });
    });

    // Menutup dialog saat klik area backdrop
    document.querySelectorAll('dialog').forEach(dialog => {
      dialog.onclick = (e: MouseEvent) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          dialog.close();
        }
      };
    });
  }

  // Inisialisasi awal dan sinkronisasi transisi halaman Astro (ViewTransitions)
  setupCVModals();
  document.addEventListener('astro:page-load', setupCVModals);
</script>

<style>
  /* Aturan mutlak hilangkan scrollbar di semua browser */
  .no-scrollbar::-webkit-scrollbar {
    display: none !important;
  }
  .no-scrollbar {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
  }

  dialog:focus-visible, dialog:focus {
    outline: none;
  }

  dialog[open] {
    animation: popUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  dialog[open]::backdrop {
    animation: fadeIn 0.3s ease-out forwards;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  @keyframes popUp {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  @keyframes fadeIn {
    from {
      background-color: rgba(0, 0, 0, 0);
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
    }
    to {
      background-color: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
  }
</style>