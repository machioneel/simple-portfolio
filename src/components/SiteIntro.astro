---
import { site } from '@data/site';
import ContactBar from './ContactBar.astro';

interface Props {
  variant: 'sidebar' | 'mobile';
}

const { variant } = Astro.props;
const isSidebar = variant === 'sidebar';

// Membuat ID unik berdasarkan posisi render (desktop atau mobile)
const modalId = `cv-modal-${variant}`;
---

{isSidebar ? (
  <>
    <div class="relative group mb-8 reveal-content flex justify-center" style="animation-delay: 100ms;">
      <div class="balloon-float w-20 h-20 md:w-24 md:h-24 rounded-full border-2 border-accent overflow-hidden shadow-[0_0_60px_theme(colors.slate.700/10%)] group-hover:shadow-[0_0_80px_theme(colors.slate.700/15%)] transition-shadow">
        <img
          src={site.hero.avatarSrc}
          alt={site.hero.avatarAlt}
          class="h-full w-full scale-110 object-cover"
          loading="eager"
          decoding="async"
          width="96"
          height="96"
        />
      </div>
      <div class="balloon-float absolute -z-10 top-1 left-1 h-full w-full rounded-full bg-slate-900/10 backdrop-blur-xl"></div>
    </div>

    <div class="flex flex-col items-center text-center">
      <a href={import.meta.env.BASE_URL} class="text-5xl font-bold tracking-tight text-white transition">
        {site.hero.name}
      </a>
      <p class="mt-3 text-xl font-medium text-slate-light">{site.hero.role}</p>
      <p class="body-copy mt-5 max-w-xs">{site.hero.tagline}</p>
      <p class="body-copy mt-5 max-w-xs">{site.hero.contact}</p>

      <button 
        data-modal-target={modalId} 
        class="cv-btn group flex items-center justify-center gap-2 cursor-pointer bg-transparent py-2 text-sm font-medium text-slate-400 transition-colors hover:text-yellow-400"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:scale-110">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        View CV
      </button>

      <div class="mt-5 flex justify-center gap-4">
        <ContactBar />
      </div>
    </div>
  </>
) : (
  <div class="flex flex-col items-center text-center">
    <div class="relative mb-4">
      <div class="balloon-float w-20 h-20 md:w-24 md:h-24 rounded-full border-2 border-accent overflow-hidden shadow-[0_0_60px_theme(colors.slate.700/10%)] group-hover:shadow-[0_0_80px_theme(colors.slate.700/15%)] transition-shadow">
        <img
          src={site.hero.avatarSrc}
          alt={site.hero.avatarAlt}
          class="h-full w-full scale-110 object-cover"
          loading="eager"
          decoding="async"
          width="96"
          height="96"
        />
      </div>
    </div>
    <h1 class="text-4xl font-bold tracking-tight text-white transition">
      {site.hero.name}
    </h1>
    <p class="mt-3 text-xl font-semibold tracking-tight text-slate-light">{site.hero.role}</p>
    <div class="mt-4 max-w-prose space-y-3 text-lg leading-relaxed text-slate">
      <p>{site.hero.tagline}</p>
      <p>{site.hero.contact}</p>
      <div class="mt-6 flex justify-center">
        <button data-modal-target={modalId} class="cv-btn cursor-pointer rounded-full bg-white/10 px-6 py-2 text-sm font-semibold text-white transition-colors hover:bg-white/20">
          View CV
        </button>
      </div>
    </div>
    <div class="mt-2 mb-6 flex items-center justify-center gap-4">
      <ContactBar />
    </div>
  </div>
)}

<dialog 
  id="captcha-modal" 
  class="m-auto rounded-xl border border-neutral-800 bg-neutral-950 p-6 shadow-2xl text-white outline-none focus:outline-none backdrop:bg-neutral-900/80 backdrop:backdrop-blur-sm"
>
  <h3 class="mb-4 text-lg font-semibold">Ciiee Penasaran</h3>
  <p class="mb-2 text-sm text-neutral-400">Masukkin dulu yaa angkanya :)</p>
  
  <div id="captcha-display" class="mb-4 text-3xl font-mono tracking-[0.25em] bg-neutral-900 p-4 text-center rounded select-none font-bold"></div>
  
  <input 
    type="text" 
    id="captcha-input" 
    maxlength="6" 
    class="w-full mb-4 p-2 rounded bg-neutral-800 border border-neutral-700 text-white text-center font-mono tracking-[0.25em] text-xl focus:outline-none focus:border-neutral-500 transition-colors" 
    placeholder="000000" 
  />
  
  <div class="flex gap-3 justify-end">
    <button id="cancel-captcha" class="px-4 py-2 rounded bg-neutral-800 hover:bg-neutral-700 transition text-sm cursor-pointer">Batal</button>
    <button id="verify-captcha" class="px-4 py-2 rounded bg-white text-black font-semibold hover:bg-neutral-200 transition text-sm cursor-pointer">Verifikasi</button>
  </div>
</dialog>

<dialog 
  id={modalId} 
  class="cv-dialog m-auto w-[85vw] max-w-4xl h-[88vh] rounded-xl border border-neutral-800 bg-neutral-950 p-0 shadow-2xl overflow-hidden outline-none focus:outline-none focus-visible:outline-none"
>
  <iframe 
    src={`${site.hero.resumeUrl}#toolbar=0&navpanes=0&scrollbar=0`}
    class="w-full h-full border-none outline-none block overflow-hidden" 
    title="CV PDF Viewer"
  ></iframe>
</dialog>

<script>
  const btns = document.querySelectorAll('.cv-btn');
  const dialogs = document.querySelectorAll<HTMLDialogElement>('.cv-dialog');
  
  // Elemen Captcha
  const captchaModal = document.getElementById('captcha-modal') as HTMLDialogElement;
  const captchaDisplay = document.getElementById('captcha-display') as HTMLDivElement;
  const captchaInput = document.getElementById('captcha-input') as HTMLInputElement;
  const verifyBtn = document.getElementById('verify-captcha') as HTMLButtonElement;
  const cancelBtn = document.getElementById('cancel-captcha') as HTMLButtonElement;
  
  let targetCvModal: HTMLDialogElement | null = null;
  let currentCaptchaCode = '';

  // Fungsi membuat 6 angka acak
  function generateCaptcha() {
    currentCaptchaCode = Math.floor(100000 + Math.random() * 900000).toString();
    captchaDisplay.textContent = currentCaptchaCode;
    captchaInput.value = '';
  }

  // 1. Klik View CV memicu modal Captcha
  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-modal-target');
      if (targetId) {
        targetCvModal = document.getElementById(targetId) as HTMLDialogElement;
        generateCaptcha();
        captchaModal.showModal();
        // Fokuskan input secara otomatis untuk kemudahan mengetik
        setTimeout(() => captchaInput.focus(), 100);
      }
    });
  });

  // 2. Proses Verifikasi
  const verifyAction = () => {
    if (captchaInput.value === currentCaptchaCode) {
      captchaModal.close();
      targetCvModal?.showModal();
    } else {
      alert('Kode Captcha tidak sesuai. Silakan coba lagi.');
      generateCaptcha();
      captchaInput.focus();
    }
  };

  verifyBtn.addEventListener('click', verifyAction);
  
  // Dukungan tekan tombol "Enter" di keyboard
  captchaInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') verifyAction();
  });

  // 3. Tombol Batal
  cancelBtn.addEventListener('click', () => captchaModal.close());

  // 4. Tutup modal CV dengan klik area blur
  dialogs.forEach(dialog => {
    dialog.addEventListener('click', (e: MouseEvent) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        dialog.close();
      }
    });
  });
</script>